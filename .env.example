# PlayThings® Environment Variables
# Copy to .env.local — email signup saves to Supabase when these are set.

# Supabase (Settings > API in your project)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Video embed (YouTube/Vimeo)
VITE_VIDEO_EMBED_URL=https://www.youtube.com/embed/your-video-id?autoplay=1
